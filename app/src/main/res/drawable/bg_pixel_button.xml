<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pixel_black"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>

    <item android:bottom="4dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pixel_yellow"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>

    <item android:bottom="30dp" android:left="6dp" android:right="6dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#55FFFFFF"/> <corners android:radius="2dp"/>
        </shape>
    </item>
</layer-list>