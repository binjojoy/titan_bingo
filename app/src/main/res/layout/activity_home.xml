<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/bgTop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        app:layout_constraintHeight_percent="0.30"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bgBottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/retro_bg_pink"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bgTop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/pixel_black"
        app:layout_constraintTop_toBottomOf="@id/bgTop" />

    <TextView
        android:id="@+id/tvHomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BINGO"
        android:fontFamily="@font/pixelify_sans_medium"
        android:textSize="64sp"
        android:textColor="#FF69B4"
        android:shadowColor="@color/pixel_black"
        android:shadowDx="6"
        android:shadowDy="6"
        android:shadowRadius="1"
        android:letterSpacing="0.1"
        app:layout_constraintBottom_toTopOf="@id/tvWelcome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WELCOME BACK!"
        android:fontFamily="@font/pixelify_sans_medium"
        android:textSize="16sp"
        android:textColor="@color/pixel_black"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@id/layoutHearts"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHomeTitle"/>

    <LinearLayout
        android:id="@+id/layoutHearts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="@id/bgTop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome">
        <TextView android:text="❤️" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp"/>
        <TextView android:text="❤️" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp"/>
        <TextView android:text="❤️" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp"/>
        <TextView android:text="❤️" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp"/>
        <TextView android:text="❤️" android:textSize="20sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bgTop">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStart"
            android:layout_width="240dp"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pixel_button"
            android:text="START GAME"
            android:fontFamily="@font/pixelify_sans_medium"
            android:textSize="20sp"
            android:textColor="@color/pixel_black"
            android:stateListAnimator="@null"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOptions"
            android:layout_width="240dp"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pixel_button"
            android:text="OPTIONS"
            android:fontFamily="@font/pixelify_sans_medium"
            android:textSize="20sp"
            android:textColor="@color/pixel_black"
            android:stateListAnimator="@null"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAbout"
            android:layout_width="240dp"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pixel_button"
            android:text="ABOUT"
            android:fontFamily="@font/pixelify_sans_medium"
            android:textSize="20sp"
            android:textColor="@color/pixel_black"
            android:stateListAnimator="@null"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnQuit"
            android:layout_width="240dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_pixel_button"
            android:text="QUIT"
            android:fontFamily="@font/pixelify_sans_medium"
            android:textSize="20sp"
            android:textColor="@color/pixel_black"
            android:stateListAnimator="@null"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>