<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/retro_bg_pink"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BINGO"
        android:fontFamily="@font/pixelify_sans_medium"
        android:textSize="48sp"
        android:textColor="@color/text_header"
        android:shadowColor="@color/pixel_black"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/lines_completed_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lines: 0/5"
        android:fontFamily="@font/pixelify_sans_medium"
        android:textColor="@color/pixel_black"
        android:textSize="18sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/columnHeaders"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp"
        app:layout_constraintStart_toStartOf="@id/boardContainer"
        app:layout_constraintEnd_toEndOf="@id/boardContainer"
        app:layout_constraintBottom_toTopOf="@id/boardContainer">

        <TextView style="@style/BingoHeader" android:text="B" />
        <TextView style="@style/BingoHeader" android:text="I" />
        <TextView style="@style/BingoHeader" android:text="N" />
        <TextView style="@style/BingoHeader" android:text="G" />
        <TextView style="@style/BingoHeader" android:text="O" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/boardContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_retro_board"
        android:padding="8dp"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintWidth_percent="0.95"
        app:layout_constraintTop_toBottomOf="@id/lines_completed_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/infoPanel"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="16dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:scrollbars="none"/>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_retro_board"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/btn_reset"
        app:layout_constraintStart_toStartOf="@id/boardContainer"
        app:layout_constraintEnd_toEndOf="@id/boardContainer"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pixelify_sans_medium"
            android:text="Connecting..."
            android:textColor="@color/pixel_black"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/player_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pixelify_sans_medium"
            android:text="P1: ... | P2: ..."
            android:textColor="@color/text_header"
            android:textSize="12sp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RESET SERVER"
        android:fontFamily="@font/pixelify_sans_medium"
        android:textSize="12sp"
        android:backgroundTint="@color/pixel_black"
        android:textColor="@color/pixel_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>